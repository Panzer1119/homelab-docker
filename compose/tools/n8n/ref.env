# n8n task runner authentication. Use a random secret you generate.
N8N_RUNNERS_AUTH_TOKEN="op://Docker/n8n/Runners-Auth-Token"

# Sandbox service secrets — pick your own values
SANDBOX_API_KEYS="op://Docker/n8n/Sandbox/Service-API-Key"
SANDBOX_API_RUNNER_REGISTRATION_TOKEN="op://Docker/n8n/Sandbox/Runner-Registration-Token"
SANDBOX_API_RUNNER_API_KEY="op://Docker/n8n/Sandbox/Runner-API-Key"

# Must match a value in SANDBOX_API_KEYS above — this is how n8n authenticates to the sandbox
N8N_INSTANCE_AI_SANDBOX_ENABLED="true"
N8N_INSTANCE_AI_SANDBOX_PROVIDER="n8n-sandbox"
N8N_SANDBOX_SERVICE_URL="http://sandbox-api:8080"
N8N_SANDBOX_SERVICE_API_KEY="op://Docker/n8n/Sandbox/Service-API-Key"

# Web search: secret for the bundled SearXNG instance — pick your own value
SEARXNG_SECRET="op://Docker/n8n/SearXNG/Secret"
N8N_INSTANCE_AI_SEARXNG_URL="http://searxng:8080"

# AI model
N8N_INSTANCE_AI_MODEL="openai/gpt-6.1-terra"
N8N_INSTANCE_AI_MODEL_API_KEY="op://Docker/n8n/OpenAI/API-Key"

# Postgres
POSTGRES_USER="op://Docker/n8n/Postgres/Username"
POSTGRES_PASSWORD="op://Docker/n8n/Postgres/Password"
POSTGRES_DB="op://Docker/n8n/Postgres/Database"

# Metrics
N8N_METRICS="false"

# Reverse proxy settings
N8N_AI_ASSISTANT_BASE_URL="op://Docker/n8n/Base-URL"
N8N_EDITOR_BASE_URL="op://Docker/n8n/Base-URL"
N8N_WEBHOOK_URL="op://Docker/n8n/Base-URL"
N8N_PROXY_HOPS="1"
VUE_APP_URL_BASE_API="op://Docker/n8n/Base-URL"
