DEVICE_ID="expansion_shelf_1"
DEVICE_NAME="Expansion Shelf 1"
BASE="expansion-shelf-1"

# Supermicro BMC
BMC_HOST="op://Docker/Supermicro-JBOD-Expansion-Shelf-1/BMC/Host"
BMC_USER="op://Docker/Supermicro-JBOD-Expansion-Shelf-1/BMC/Username"
BMC_PASSWORD="op://Docker/Supermicro-JBOD-Expansion-Shelf-1/BMC/Password"

# Home Assistant MQTT broker
MQTT_HOST="op://Docker/Supermicro-JBOD-Expansion-Shelf-1/MQTT/Host"
MQTT_PORT="op://Docker/Supermicro-JBOD-Expansion-Shelf-1/MQTT/Port"
MQTT_USER="op://Docker/Supermicro-JBOD-Expansion-Shelf-1/MQTT/Username"
MQTT_PASSWORD="op://Docker/Supermicro-JBOD-Expansion-Shelf-1/MQTT/Password"

# Polling
POLL_INTERVAL="30"
